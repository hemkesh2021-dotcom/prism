# PRISM backend configuration. Copy to backend/.env (never commit .env).
# The key and model are read only by the Python server; nothing here reaches the browser.

# --- Live analysis (optional: the sample demo works without these) -----------
# Your Anthropic API key. Live analysis is paid usage on your own account.
ANTHROPIC_API_KEY=

# Model ID. Any Claude model that supports structured outputs works.
# Verified on 2026-10-26 against https://platform.claude.com/docs/en/models/overview :
#   claude-sonnet-5-5   balanced speed and quality (recommended)
#   claude-haiku-5-5    lowest cost and latency
#   claude-opus-5-5     highest quality of the three, slower and more expensive
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional effort level: low | medium | high | xhigh | max. Leave empty to use the
# model's default. Remove it for older models that do not support the effort parameter.
ANTHROPIC_EFFORT=medium

# --- Limits and timeouts (defaults shown) ------------------------------------
PRISM_MAX_TRANSCRIPT_CHARS=40000
PRISM_MAX_UPLOAD_BYTES=262144
# Per model request. At most two requests are made per analysis.
PRISM_MODEL_TIMEOUT_SECONDS=120
# Upper bound on model output, including the model's internal thinking tokens.
PRISM_MAX_OUTPUT_TOKENS=16000

# --- Development --------------------------------------------------------------
# The only origin allowed by CORS (the Vite dev server).
PRISM_FRONTEND_ORIGIN=http://localhost:5173
# Serve frontend/dist from this server when it exists (single-port mode).
PRISM_SERVE_FRONTEND=true
